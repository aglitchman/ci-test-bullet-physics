name: "defold_patch"

platforms:
    armv7-android:
        context:
            excludeLibs: [gameobject, gamesys, physics_3d, BulletCollision, BulletDynamics]

    arm64-android:
        context:
            excludeLibs: [gameobject, gamesys, physics_3d, BulletCollision, BulletDynamics]

    wasm-web:
        context:
            excludeLibs: [gameobject, gamesys, physics_3d, BulletCollision, BulletDynamics]

    x86_64-win32:
        context:
            excludeLibs: [libgameobject, libgamesys, libphysics_3d, libBulletCollision, libBulletDynamics]

